{
  "manifest_version": 3,
  "name": "Viral DRM Collector",
  "version": "1.3.1",
  "description": "Collects original client videos from TikTok, X, Facebook, Instagram, and YouTube and sends them to Viral DRM for tracking.",
  "action": {
    "default_title": "Viral DRM Collector"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "permissions": ["storage", "activeTab", "sidePanel", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://www.tiktok.com/@*"],
      "js": ["content-tiktok-network.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.tiktok.com/@*"],
      "js": ["content-tiktok.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content-x.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content-facebook-network.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["content-facebook.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content-instagram-network.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content-instagram.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://business.facebook.com/*"],
      "js": ["content-rights-manager-network.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://business.facebook.com/*"],
      "js": ["content-rights-manager.js"],
      "run_at": "document_start"
    }
  ]
}
